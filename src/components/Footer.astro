---
import '../styles/global.css';
import CookieModal from './CookieModal.astro';

const currentYear = new Date().getFullYear();

const socialLinks = [
    { name: "Instagram", url: "https://instagram.com", icon: "/assets/svg/instagram.svg" },
    { name: "Twitter", url: "https://twitter.com", icon: "/assets/svg/twitterx.svg" },
    { name: "YouTube", url: "https://youtube.com", icon: "/assets/svg/youtube.svg" },
    { name: "Facebook", url: "https://facebook.com", icon: "/assets/svg/facebook.svg" },
];

const modelLinks = [
    { name: "Grecale", id: "grecale" },
    { name: "GranCabrio", id: "grancabrio" },
    { name: "MC20", id: "mc20" },
    { name: "Ghibli", id: "ghibli" },
];

const worldLinks = [
    { name: "Comunidad", href: "/comunidad" },
    { name: "Mapa", href: "/mapa" },
    { name: "Sobre Nosotros", href: "/sobreNosotros" },
];

const purchaseLinks = [
    { name: "Eventos", href: "/eventos" },
    { name: "Tienda", href: "/tienda" },
];
---

<footer class="bg-maserati-negro border-t border-maserati-gris/30 pt-16 pb-8 text-sm relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-12 mb-16">
        
            <div class="col-span-2 md:col-span-1 space-y-6">
                <a href="/" class="block w-32 opacity-90 hover:opacity-100 transition-opacity">
                    <img src="/assets/images/logos-image/logoMaserati.png" alt="Maserati Footer Logo" class="w-full h-auto" />
                </a>
                <p class="text-maserati-plata leading-relaxed text-xs md:text-sm">
                    Lujo, elegancia y velocidad. <br>
                    La excelencia italiana desde 1914.
                </p>
                
                <div class="flex gap-4 items-center mt-6">
                    {socialLinks.map((social) => (
                        <a 
                            href={social.url} 
                            target="_blank" 
                            class="transition-transform duration-300 hover:scale-110 opacity-70 hover:opacity-100 p-2 hover:bg-white/5 rounded-full" 
                            aria-label={social.name}
                        >
                            <img 
                                src={social.icon} 
                                alt={social.name} 
                                class="w-8 h-8 md:w-10 md:h-10 landscape:w-10 landscape:h-10 object-contain" 
                            />
                        </a>
                    ))}
                </div>
            </div>

            <div>
                <h3 class="text-white font-bold uppercase tracking-widest mb-6 text-xs md:text-sm border-b border-white/10 pb-2 w-fit">Modelos</h3>
                <ul class="space-y-3">
                    {modelLinks.map((model) => (
                        <li>
                            <button 
                                data-model={model.id} 
                                class="config-trigger text-maserati-plata hover:text-amber-400 transition-colors text-left w-full cursor-pointer text-xs md:text-sm flex items-center group"
                            >
                                <span class="w-0 group-hover:w-2 transition-all duration-300 h-px bg-amber-400 mr-0 group-hover:mr-2"></span>
                                {model.name}
                            </button>
                        </li>
                    ))}
                </ul>
            </div>

            <div>
                <h3 class="text-white font-bold uppercase tracking-widest mb-6 text-xs md:text-sm border-b border-white/10 pb-2 w-fit">Mundo Maserati</h3>
                <ul class="space-y-3">
                    {worldLinks.map((link) => (
                        <li>
                            <a href={link.href} class="text-maserati-plata hover:text-amber-400 transition-colors text-xs md:text-sm block">
                                {link.name}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <div>
                <h3 class="text-white font-bold uppercase tracking-widest mb-6 text-xs md:text-sm border-b border-white/10 pb-2 w-fit">Compra</h3>
                <ul class="space-y-3">
                    {purchaseLinks.map((link) => (
                        <li>
                            <a href={link.href} class="text-maserati-plata hover:text-amber-400 transition-colors text-xs md:text-sm block">
                                {link.name}
                            </a>
                        </li>
                    ))}
                    <li>
                        <a href="/contacto" class="text-maserati-cian hover:text-maserati-amber font-semibold transition-colors mt-6 inline-flex items-center gap-2 text-xs md:text-sm border border-maserati-cian/30 px-4 py-2 rounded hover:border-maserati-amber">
                            Contáctanos <span>&rarr;</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="border-t border-maserati-gris/20 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-maserati-plata text-[12px] md:text-xs text-center md:text-left opacity-60">
                &copy; {currentYear} Nim's Maserati. Todos los derechos reservados.
            </p>
            <div class="flex gap-6 text-[12px] md:text-xs text-maserati-plata font-medium">
                <a href="/accesibilidad" class="hover:text-amber-400 transition-colors">Accesibilidad</a>
                <button id="open-cookies" class="hover:text-amber-400 transition-colors cursor-pointer">
                    Configuración Cookies
                </button>
            </div>
        </div>
    </div>

    <button 
        id="scroll-up" 
        aria-label="Volver arriba"
        class="fixed bottom-8 right-8 bg-maserati-azul text-white p-3 rounded-full shadow-lg opacity-0 pointer-events-none transition-all duration-500 hover:bg-maserati-amber hover:text-black hover:-translate-y-1 z-40 cursor-pointer translate-y-10"
    >
        <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
    </button>

    <CookieModal />

</footer>

<script>
    import { openConfigurator } from '../stores/configuratorStore';

    const scrollBtn = document.getElementById('scroll-up');
    
    window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
            scrollBtn?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
        } else {
            scrollBtn?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
        }
    });

    scrollBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });


    const triggers = document.querySelectorAll('.config-trigger');
    triggers.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const modelId = btn.getAttribute('data-model');
            if (modelId) openConfigurator(modelId);
        });
    });
</script>